<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:title="API 키">
        <EditTextPreference android:key="gemini_api_key" android:title="Gemini API 키 (필수)"
            android:dialogMessage="Google AI Studio(aistudio.google.com/apikey)에서 무료로 발급받은 키를 붙여 넣으세요. 키는 이 기기에만 저장됩니다." />
        <Preference android:key="gemini_key_help" android:title="Gemini API 키 발급받기"
            android:summary="aistudio.google.com/apikey 열기">
            <intent android:action="android.intent.action.VIEW" android:data="https://aistudio.google.com/apikey" />
        </Preference>
        <EditTextPreference android:key="its_api_key" android:title="ITS API 키 (선택, 개인 키)"
            android:dialogMessage="전국 국도 CCTV용 국가교통정보센터(its.go.kr) OpenAPI 키입니다. 앱에 기본 키가 들어 있어 비워 둬도 되며, 개인 키를 입력하면 그 키를 우선 사용합니다. 기본 키의 하루 호출 한도가 찼을 때 유용합니다." />
    </PreferenceCategory>
    <PreferenceCategory android:title="분석 동작">
        <SwitchPreferenceCompat android:key="auto_analyze" android:title="자동 분석"
            android:summary="앱 실행 시 가장 가까운 CCTV를 바로 분석합니다" android:defaultValue="true" />
        <ListPreference android:key="search_radius_km" android:title="검색 반경"
            android:entries="@array/radius_entries" android:entryValues="@array/radius_values"
            android:defaultValue="10" app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat android:key="exclude_sheltered" android:title="지붕 아래 사람 제외"
            android:summary="버스정류장·건물 처마 아래나 실내에 있어 비를 맞지 않는 사람은 우산 비율에서 뺍니다 (걷는 사람·신호 대기자는 모두 포함)"
            android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:title="결과 표시 방식">
        <SwitchPreferenceCompat android:key="voice_enabled" android:title="음성 안내 (TTS)"
            android:summary="분석 결과를 한국어 음성으로 읽어줍니다" android:defaultValue="true" />
        <SwitchPreferenceCompat android:key="screen_enabled" android:title="화면 표시"
            android:summary="분석 결과를 화면 카드에 표시합니다" android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:title="목록">
        <SwitchPreferenceCompat android:key="show_list" android:title="CCTV 목록 표시"
            android:summary="주변 CCTV 목록을 화면에 표시합니다" android:defaultValue="true" />
        <SwitchPreferenceCompat android:key="include_highway_cctv" android:title="고속도로·외곽 CCTV 포함"
            android:summary="국도·고속도로 CCTV(ITS)를 목록에 포함합니다. 끄면 서울 시내 CCTV만 표시됩니다."
            android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:title="앱 정보">
        <Preference android:key="app_version" android:title="버전" android:selectable="false" />
        <Preference android:key="app_homepage" android:title="홈페이지"
            android:summary="earlln.com · 최신 버전 받기">
            <intent android:action="android.intent.action.VIEW" android:data="https://earlln.com/product.html#earllnrainornot" />
        </Preference>
    </PreferenceCategory>
</PreferenceScreen>
